# Скопируйте этот файл в .secrets и заполните значения.
# Файл .secrets добавлен в .gitignore и НИКОГДА не коммитится.
#
# Локально (act)      : act читает .secrets автоматически.
# GitHub (repo)       : те же значения внесите в
#   Settings -> Secrets and variables -> Actions
#
# Токен Semgrep (необязателен для открытых конфигов p/default,
# нужен для отправки находок в semgrepdev dashboard)
SEMGREP_APP_TOKEN=

# Секрет приложения, передаётся контейнеру на Stage 4 (Deploy)
# через переменную окружения APP_SECRET
APP_SECRET=change-me-locally
